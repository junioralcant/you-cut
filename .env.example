# Obrigatório: chave de API da Anthropic (Claude)
ANTHROPIC_API_KEY=sua_chave_aqui

# Opcionais: sobrescrevem os valores padrão
# WHISPER_MODEL=medium         # tiny, base, small, medium, large-v3
# CLAUDE_MODEL=claude-sonnet-4-6
# CLIP_COUNT=5
# SUBTITLE_STYLE=word          # word ou phrase
# OUTPUT_DIR=output
# DRY_RUN=false

# Upload para YouTube
# YOUTUBE_CLIENT_SECRETS_FILE=/caminho/para/client_secret.json

# Upload para Instagram
# OAuth interativo:
# INSTAGRAM_APP_ID=seu_app_id
# INSTAGRAM_APP_SECRET=seu_app_secret
# Ou token já emitido:
# INSTAGRAM_ACCESS_TOKEN=seu_access_token
# INSTAGRAM_USER_ID=seu_instagram_business_user_id

# Upload para TikTok
# TIKTOK_CLIENT_KEY=seu_client_key
